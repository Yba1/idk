direction: down

request: "1. Validate query"
profile: "2. Load memory profile"
hyde: "3. HyDE expansion [LLM]"
retrieve: "4. Retrieve papers"
rerank: "5. Memory re-rank"
relevance: "6. Relevance check [LLM]"
refine: "7. Refine query [LLM]"
summary: "8. Write summary [LLM]"
citations: "9. Citation check [LLM]"
distill: "10. Memory distill [LLM]"
response: "11. Return answer + cost"

request -> profile -> hyde -> retrieve -> rerank -> relevance -> refine -> summary -> citations -> distill -> response
