title: Paritok Overall Impact: Development and Token Efficiency
direction: down
classes: {
  trigger: { style.fill: "#e1d5e7"; style.stroke: "#9673a6"; style.font-size: 22; style.stroke-width: 2 }
  external: { style.fill: "#d5e8d4"; style.stroke: "#82b366"; shape: cloud; style.font-size: 22; style.stroke-width: 2 }
  logic: { style.fill: "#dae8fc"; style.stroke: "#6c8ebf"; style.font-size: 22; style.stroke-width: 2 }
  review: { style.fill: "#fff2cc"; style.stroke: "#d6b656"; style.font-size: 22; style.stroke-width: 2 }
  error: { style.fill: "#f8cecc"; style.stroke: "#b85450"; style.stroke-dash: 3; style.font-size: 22; style.stroke-width: 2 }
  storage: { style.fill: "#f5f5f5"; style.stroke: "#666666"; shape: cylinder; style.font-size: 22; style.stroke-width: 2 }
  mocked: { style.fill: "#ffe6cc"; style.stroke: "#d79b00"; shape: queue; style.font-size: 22; style.stroke-width: 2 }
}
paritok_source: {
  label: "Paritok compression pipeline (account-wide, all API keys)"
  class: logic
}
llm_request: {
  label: "LLM Request / Token Efficiency"
  style.font-size: 24
  direction: down
  candidate_b: {
    label: "Sourced-summary call: gate winner, 40.9% reduction"
    class: logic
  }
  batch_14: {
    label: "14-query real-corpus batch: 54% average reduction, up to 95% peak"
    class: external
  }
  pipeline_range: {
    label: "End-to-end gold-set runs: 26.38% to 60.26% reduction across 3 dated runs"
    class: storage
  }
  candidate_b -> batch_14 -> pipeline_range: "" { style.opacity: 0 }
}
aggregate: {
  label: "Aggregate: Account-wide Totals"
  style.font-size: 24
  totals: {
    label: "340.82M tokens saved of 385.86M processed, 88.3% of volume, 107.25 USD estimated cost saved across 5.6K requests"
    class: logic
  }
}
paritok_source -> llm_request
paritok_source -> aggregate
