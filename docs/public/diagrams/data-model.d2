title: NeuLitTrace Data Model

# Core corpus and metadata
condition: Condition {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  name: string
  "rarity: rare or common"
  pubmed_query: string
  region_literature: string
  atlas_label: string
  target_count: int
  "overlaps_with: list[str]"
}

paper: Paper {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  pmid: string
  title: string
  abstract: string
  condition: string
  rarity: string
  region_literature: string
  atlas_label: string
  "overlaps_with: list[str]"
}

# Search and retrieval flow
loop_trace_entry: LoopTraceEntry {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  iteration: int
  "retrieved_pmids: list[str]"
  relevant: bool
  confidence: float
  note: string
  relevant_count: int
  total_count: int
}

# Summary generation
sourced_summary: SourcedSummary {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  text: string
  "citations: list[dict]"
  raw_text: string
  degraded: bool
  original_tokens: int
  compressed_tokens: int
  "imaging_findings: string or null"
  "teaching_point: string or null"
  "differential_candidates: list[dict]"
}

# API response schemas
query_response: QueryResponse {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  summary_text: string
  "citations: list[CitationOut]"
  "trace: list[TraceEntryOut]"
  low_confidence: bool
  degraded: bool
  no_match: bool
  "suggested_conditions: list[SuggestedConditionOut]"
  "flagged_claims: list[dict]"
  "case_context: CaseContextOut or null"
  "differential: list[DifferentialItemOut]"
}

citation_out: CitationOut {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  marker: string
  pmid: string
  title: string
  condition: string
}

trace_entry_out: TraceEntryOut {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  iteration: int
  "retrieved_pmids: list[str]"
  relevant: bool
  confidence: float
  note: string
  relevant_count: int
  total_count: int
}

case_context_out: CaseContextOut {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  condition_name: string
  rarity: string
  region_literature: string
  atlas_label: string
  corpus_paper_count: int
  "imaging_findings: string or null"
  "teaching_point: string or null"
}

differential_item_out: DifferentialItemOut {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  condition_name: string
  marker: string
  pmid: string
}

suggested_condition_out: SuggestedConditionOut {
  shape: sql_table
  style.fill: "#64748b"
  style.stroke: "#f1f5f9"
  style.font-size: 16
  name: string
  paper_count: int
}

# Relationships
condition -> paper: "1..* via Paper.condition = Condition.name"
condition -> condition: "many-to-many self-reference via overlaps_with"
paper -> loop_trace_entry: "retrieved by retrieved_pmids"
loop_trace_entry -> trace_entry_out: "1:1 maps to API response"
paper -> sourced_summary: "list built into citations"
sourced_summary -> query_response: "maps to response fields"
condition -> case_context_out: "looked up from condition name"
sourced_summary -> differential_item_out: "differential_candidates"
case_context_out -> query_response: "included as case_context field"
citation_out -> query_response: "included as citations array"
trace_entry_out -> query_response: "included as trace array"
differential_item_out -> query_response: "included as differential array"
suggested_condition_out -> query_response: "included as suggested_conditions"
