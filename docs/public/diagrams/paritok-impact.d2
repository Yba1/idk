title: Paritok Impact, Development vs Token Efficiency

vars: {
  d2-config: {
    layout-engine: elk
  }
}

# Numbers match the current backend/measurement/results/decision.md gate run.

classes: {
  trigger: {
    style.fill: "#e1d5e7"
    style.stroke: "#9673a6"
    style.font-size: 22
    style.stroke-width: 2
  }
  external: {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    shape: cloud
    style.font-size: 22
    style.stroke-width: 2
  }
  logic: {
    style.fill: "#dae8fc"
    style.stroke: "#6c8ebf"
    style.font-size: 22
    style.stroke-width: 2
  }
  review: {
    style.fill: "#fff2cc"
    style.stroke: "#d6b656"
    style.font-size: 22
    style.stroke-width: 2
  }
  error: {
    style.fill: "#f8cecc"
    style.stroke: "#b85450"
    style.stroke-dash: 3
    style.font-size: 22
    style.stroke-width: 2
  }
  storage: {
    style.fill: "#f5f5f5"
    style.stroke: "#666666"
    shape: cylinder
    style.font-size: 22
    style.stroke-width: 2
  }
  mocked: {
    style.fill: "#ffe6cc"
    style.stroke: "#d79b00"
    shape: queue
    style.font-size: 22
    style.stroke-width: 2
  }
}

paritok_source: {
  label: "Paritok GPU compression (compress_for_prompt)"
  class: logic
}

dev_side: {
  label: "Development Impact"
  style.font-size: 24

  config_toggle: {
    label: "Single toggle: use_gpu_server (paritok.yaml)"
    class: logic
  }
  cold_start: {
    label: "Cold starts exceed timeout (45.5s observed, 90s default)"
    class: error
  }
  no_retry: {
    label: "No retry or backoff in GpuServerStrategy.compress()"
    class: error
  }
  silent_fail: {
    label: "Failed compression silently returns ratio 0.0"
    class: error
  }
  ref_leak: {
    label: "REF hash tag leaks into LLM prompt, corrupts citations"
    class: error
  }
  workaround: {
    label: "Required custom thread with 8s join() wrapper in llm_client.py"
    class: mocked
  }

  config_toggle -> cold_start
  config_toggle -> no_retry
  config_toggle -> silent_fail
  config_toggle -> ref_leak
  cold_start -> workaround
  no_retry -> workaround
  silent_fail -> workaround
  ref_leak -> workaround
}

token_side: {
  label: "LLM Request / Token Impact"
  style.font-size: 24

  candidate_a: {
    label: "Candidate A: search-loop calls, 1434 to 1442 tokens, -0.56% (below 15% gate)"
    class: error
  }
  candidate_b: {
    label: "Candidate B: sourced-summary call, 4159 to 2458 tokens, 40.9% (gate winner)"
    class: logic
  }
  batch_14: {
    label: "14-query real-corpus batch: 54% average, 80-95% peak on sparse content"
    class: external
  }
  variance: {
    label: "High variance: some queries 0%, others 80-95%"
    class: review
  }
  pipeline_range: {
    label: "End-to-end gold-set runs: 26.38% to 60.26% across 3 dated runs"
    class: storage
  }

  candidate_b -> batch_14
  batch_14 -> variance
  candidate_b -> pipeline_range
}

paritok_source -> dev_side.config_toggle
paritok_source -> token_side.candidate_a
paritok_source -> token_side.candidate_b
