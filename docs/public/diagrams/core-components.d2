title: NeuLitTrace Core Components by Architectural Layer

direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  trigger: {
    style.fill: "#e1d5e7"
    style.stroke: "#9673a6"
    style.font-size: 22
    style.stroke-width: 2
  }
  external: {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    shape: cloud
    style.font-size: 22
    style.stroke-width: 2
  }
  logic: {
    style.fill: "#dae8fc"
    style.stroke: "#6c8ebf"
    style.font-size: 22
    style.stroke-width: 2
  }
  review: {
    style.fill: "#fff2cc"
    style.stroke: "#d6b656"
    style.font-size: 22
    style.stroke-width: 2
  }
  storage: {
    style.fill: "#f5f5f5"
    style.stroke: "#666666"
    shape: cylinder
    style.font-size: 22
    style.stroke-width: 2
  }
}

# Presentation Layer
presentation: {
  shape: rectangle
  label: "Presentation Layer"
  class: trigger
  style.font-size: 26

  app_router: "Next.js App Router"
  tailwind: "Tailwind CSS 4"
  shadcn: "shadcn/ui (Radix primitives)"
  components: "Query Form, Trace, Summary, Brain Viewer, Timeline"
}

# API Layer
api: {
  shape: rectangle
  label: "API Layer"
  class: logic
  style.font-size: 26

  fastapi: "FastAPI (>=0.115.0)"
  pydantic: "Pydantic validation"
  slowapi: "slowapi rate limiting"
  endpoints: "POST /query, GET /demo-contrast, GET /conditions, GET /atlas"
}

# Retrieval and Pipeline
retrieval_pipeline: {
  shape: rectangle
  label: "Retrieval and Pipeline"
  class: logic
  style.font-size: 26

  bm25: "BM25 lexical search (rank-bm25)"
  embeddings: "Sentence-transformers vector search"
  search_loop: "Search loop orchestration"
  hyde: "HyDE query expansion"
  relevance: "Relevance check"
  rarity_boost: "Rarity boost multiplier"
}

# LLM and External Services
llm_services: {
  shape: rectangle
  label: "LLM and External Services"
  class: external
  style.font-size: 26

  groq_api: "Groq API (llama-3.3-70b-versatile)"
  paritok_proxy: "Paritok Proxy (local, port 8080)"
  paritok_gpu: "Paritok GPU compression"
}

# Data
data: {
  shape: rectangle
  label: "Data Storage"
  class: storage
  style.font-size: 26

  corpus: "Flat JSON corpus (329 papers, 14 conditions)"
  in_memory: "In-memory, no persistent writes"
}

# Docs and Tooling
tooling: {
  shape: rectangle
  label: "Docs and Tooling"
  class: review
  style.font-size: 26

  d2: "D2 diagrams"
  vitepress: "VitePress docs site"
  pytest: "pytest backend tests (99 tests)"
}

# Data flow
presentation -> api: "HTTP requests" { style.font-size: 32 }
api -> retrieval_pipeline: "Query pipeline\ninvocation" { style.font-size: 32 }
retrieval_pipeline -> data: "Read corpus" { style.font-size: 32 }
retrieval_pipeline -> llm_services: "HyDE, relevance check,\nsummary generation" { style.font-size: 32 }
llm_services -> api: "LLM responses" { style.font-size: 32 }
api -> presentation: "JSON responses" { style.font-size: 32 }
