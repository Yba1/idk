direction: right

request: "Query request"
retrieval: "Retrieval\nfail → no result state"
llm: "LLM\nfail → degraded answer"
memory: "Memory\nfail → unpersonalized answer"
ledger: "Ledger\nfail → cost unavailable"
ui: "One honest UI"

request -> retrieval -> ui
request -> llm -> ui
request -> memory -> ui
request -> ledger -> ui
