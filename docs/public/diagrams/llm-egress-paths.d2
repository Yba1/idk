title: LLM Egress Paths and Retry/Fallback Logic

direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  trigger: {
    style.fill: "#e1d5e7"
    style.stroke: "#9673a6"
    style.font-size: 22
    style.stroke-width: 2
  }
  external: {
    style.fill: "#d5e8d4"
    style.stroke: "#82b366"
    shape: cloud
    style.font-size: 22
    style.stroke-width: 2
  }
  logic: {
    style.fill: "#dae8fc"
    style.stroke: "#6c8ebf"
    style.font-size: 22
    style.stroke-width: 2
  }
  review: {
    style.fill: "#fff2cc"
    style.stroke: "#d6b656"
    style.font-size: 22
    style.stroke-width: 2
  }
  error: {
    style.fill: "#f8cecc"
    style.stroke: "#b85450"
    style.stroke-dash: 3
    style.font-size: 22
    style.stroke-width: 2
  }
  storage: {
    style.fill: "#f5f5f5"
    style.stroke: "#666666"
    shape: cylinder
    style.font-size: 22
    style.stroke-width: 2
  }
  mocked: {
    style.fill: "#ffe6cc"
    style.stroke: "#d79b00"
    shape: queue
    style.font-size: 22
    style.stroke-width: 2
  }
}

# Entry point
request: { label: "LLM Request"; class: trigger; style.font-size: 26 }

# Path 1: Proxy Route
path1: {
  shape: rectangle
  label: "Path 1: Via Paritok Proxy"
  class: logic
  style.font-size: 26

  proxy_route: "Backend -> Local Paritok Proxy (127.0.0.1:8080)"
  groq_via_proxy: { label: "Groq API"; class: external }
  proxy_route -> groq_via_proxy
}

# Path 2: Direct Groq
path2: {
  shape: rectangle
  label: "Path 2: Direct to Groq"
  class: logic
  style.font-size: 26

  direct_route: "Backend -> Groq API (direct)"
  groq_direct: { label: "Groq API"; class: external }
  direct_route -> groq_direct
}

# Path 3: Compression
path3: {
  shape: rectangle
  label: "Path 3: Paritok GPU Compression"
  class: logic
  style.font-size: 26

  compress_route: "Backend -> Paritok GPU"
  paritok_gpu: { label: "Paritok GPU Server (8s timeout)"; class: external }
  compress_route -> paritok_gpu
  gpu_passthrough: { label: "Timeout: passthrough original content"; class: error }
  paritok_gpu -> gpu_passthrough
}

# Shared retry/fallback logic for Paths 1 and 2
retry_fallback: {
  shape: rectangle
  label: "Paths 1 & 2: Retry and Fallback Logic"
  class: logic
  style.font-size: 26

  retry_attempt: "Attempt primary client (up to 3 tries, exponential backoff: 2^n seconds)"
  fallback_check: "All 3 attempts failed?"
  gemini_attempt: "If GEMINI_API_KEY configured: attempt Gemini API (gemini-flash-latest)"
  gemini_check: "Gemini attempt succeeded?"
  final_failure: { label: "Return degraded=True"; class: error }

  retry_attempt -> fallback_check
  fallback_check -> gemini_attempt: "yes"
  gemini_attempt -> gemini_check
  gemini_check -> final_failure: "no (or no key configured)"
}

# Connections
request -> path1
request -> path2
request -> path3
path1.groq_via_proxy -> retry_fallback.retry_attempt
path2.groq_direct -> retry_fallback.retry_attempt
retry_fallback.fallback_check -> success_outcome: "no (succeeded within 3 tries)"
retry_fallback.gemini_check -> success_outcome: "yes"

# Final outcomes
success_outcome: { label: "Return ChatResult (content)"; class: logic; style.font-size: 26 }
