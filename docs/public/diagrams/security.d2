title: NeuLitTrace Request Security Layers

direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
}

classes: {
  trigger: {
    style.fill: "#e1d5e7"
    style.stroke: "#9673a6"
    style.font-size: 22
    style.stroke-width: 2
  }
  logic: {
    style.fill: "#dae8fc"
    style.stroke: "#6c8ebf"
    style.font-size: 22
    style.stroke-width: 2
  }
  review: {
    style.fill: "#fff2cc"
    style.stroke: "#d6b656"
    style.font-size: 22
    style.stroke-width: 2
  }
  error: {
    style.fill: "#f8cecc"
    style.stroke: "#b85450"
    style.stroke-dash: 3
    style.font-size: 22
    style.stroke-width: 2
  }
  storage: {
    style.fill: "#f5f5f5"
    style.stroke: "#666666"
    shape: cylinder
    style.font-size: 22
    style.stroke-width: 2
  }
}

request: "Incoming Request" { shape: oval; class: trigger }

l1: "L1 Origin Check" {
  cors: "CORSMiddleware\nallow_origins from FRONTEND_ORIGIN env\n(default localhost:3000), GET/POST only" { class: logic }
}

l2: "L2 Rate Limiting" {
  limiter: "slowapi Limiter\nkeyed by client IP (get_remote_address)" { class: logic }
  limits: "10/minute: /query, /query/stream\n20/minute: /atlas, /atlas/{condition}" { class: logic }
  too_many: "429 Too Many Requests" { class: error }
}

l3: "L3 Request Validation" {
  pydantic: "Pydantic schema validation\n(request body boundary, schemas.py)" { class: review }
  rejected: "422 Validation Error" { class: error }
}

l4: "L4 Secrets Handling" {
  env_load: ".env loaded before any ParitokLLMClient\nconstructs, so the key never passes\nthrough a Claude-visible tool call" { class: storage }
}

handler: "Route Handler / Query Pipeline" { shape: hexagon; class: logic }

request -> l1.cors
l1.cors -> l2.limiter
l2.limiter -> l2.limits
l2.limits -> l2.too_many: "over limit"
l2.limits -> l3.pydantic: "within limit"
l3.pydantic -> l3.rejected: "schema mismatch"
l3.pydantic -> handler: "valid body"
handler -> l4.env_load: "reads config at startup,\nnot per-request"
